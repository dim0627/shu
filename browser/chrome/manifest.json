{
  "manifest_version": 3,
  "name": "SHU",
  "version": "0.1.0",
  "description": "Shows the SHU task that refs the page you are on.",
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "SHU" }
}
